# VibeForge works without API keys in demo/mock mode.
# Add provider keys only when moving generation calls behind server routes.

OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Optional: Supabase cloud sync (Phase 2)
# Leave these empty to keep the app in local-only mode.
# When set, users can sign in and sync projects/settings to the cloud.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
