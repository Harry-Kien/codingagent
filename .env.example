# VibeForge works without API keys in demo/mock mode.
# Add provider keys only when moving generation calls behind server routes.

OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Supabase (optional — the app runs fully local without these)
# Get these from your Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only production settings. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
VIBEFORGE_PROVIDER_KEY_SECRET=

# Optional server-side default provider for deployed generation.
# Use these for OpenRouter or any OpenAI-compatible gateway. Do not expose the API key.
VIBEFORGE_SERVER_PROVIDER_API_KEY=
VIBEFORGE_SERVER_PROVIDER_NAME=OpenRouter
VIBEFORGE_SERVER_PROVIDER_TYPE=openrouter
VIBEFORGE_SERVER_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
VIBEFORGE_SERVER_PROVIDER_DEFAULT_MODEL=openai/gpt-4.1-mini
VIBEFORGE_SERVER_PROVIDER_CHEAP_MODEL=openai/gpt-4.1-mini
VIBEFORGE_SERVER_PROVIDER_STRONG_MODEL=openai/gpt-4.1
VIBEFORGE_SERVER_PROVIDER_VISION_MODEL=google/gemini-2.5-flash
VIBEFORGE_SERVER_PROVIDER_TOKEN_LIMIT=12000
VIBEFORGE_SERVER_PROVIDER_TEMPERATURE=0.35

# Public UI hints only. These do not contain secrets.
NEXT_PUBLIC_VIBEFORGE_SERVER_PROVIDER_ENABLED=true
NEXT_PUBLIC_VIBEFORGE_SERVER_PROVIDER_NAME=OpenRouter
NEXT_PUBLIC_VIBEFORGE_SERVER_PROVIDER_MODEL=openai/gpt-4.1-mini

# Optional: improves live GitHub repo trend fetching. The app falls back to
# GITHUB_TRENDS_SNAPSHOT.md when this is empty or rate-limited.
VIBEFORGE_GITHUB_TOKEN=

# Optional durable rate limiting for multi-instance/serverless production.
# Upstash Redis REST works with either VIBEFORGE_* or UPSTASH_* names.
VIBEFORGE_REDIS_REST_URL=
VIBEFORGE_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional external error reporting webhook. Payloads are sanitized and do not
# include API keys, auth tokens, ciphertext, or provider secrets.
ERROR_WEBHOOK_URL=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Vercel Analytics and Speed Insights are enabled by package/layout setup.
# No secret env is required for basic pageview and web-vitals telemetry.
